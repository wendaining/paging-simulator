{
  "name": "paging-simulator",
  "version": "0.1.0",
  "description": "A request paging memory management simulator.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "vite --host 127.0.0.1",
