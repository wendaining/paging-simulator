{
  "name": "paging-simulator",
  "version": "0.1.0",
  "description": "A request paging memory management simulator.",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run build && npm run build:web && npm run build:electron && electron .",
    "electron:pack": "npm run build && npm run build:web && npm run build:electron && cross-env ELECTRON_CACHE=.cache/electron electron-builder --dir",
    "electron:dist": "npm run build && npm run build:web && npm run build:electron && cross-env ELECTRON_CACHE=.cache/electron electron-builder",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.paging-simulator.app",
    "productName": "Paging Simulator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-web/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "element-plus": "^2.14.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.3",
    "vitest": "^3.2.0",
    "vue": "^3.5.34"
  }
}
